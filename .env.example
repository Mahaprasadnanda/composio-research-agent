# Composio Research Agent - Environment Configuration
# Copy this file to .env and provide your actual API keys.
# NEVER commit the .env file or expose real API credentials in source control.

# Groq API Key (Free tier LLM provider)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Composio API Key (Tool execution & MCP integration)
# Obtain from: https://app.composio.dev/settings
COMPOSIO_API_KEY=your_composio_api_key_here

# Optional LLM Configuration
# Model to use with Groq (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
